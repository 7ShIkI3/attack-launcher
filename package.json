{
  "name": "attack-launcher",
  "productName": "ATTACK Launcher",
  "version": "0.5.2",
  "description": "Launcher d'ATTACK Client (Minecraft PvP : 1.8.9 Forge, 1.21.1 et 26.3 Fabric) : installe le chargeur, le pack de mods et le mod, connexion Microsoft, lancement direct du jeu et mise à jour automatique.",
  "main": "src/main/main.js",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "7ShIkI3",
  "homepage": "https://github.com/7ShIkI3/attack-launcher",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js",
    "install-test": "node scripts/install-test.js",
    "launch-test": "node scripts/launch-test.js",
    "screenshot": "node scripts/screenshot.js",
    "update-test": "node scripts/update-test.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "pack": "electron-builder --win --dir --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "io.github.7shiki3.attacklauncher",
    "productName": "ATTACK Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "7ShIkI3",
        "repo": "attack-launcher",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ATTACK Launcher",
      "artifactName": "ATTACK-Launcher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ATTACK-Launcher-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "skinview3d": "3.4.2"
  }
}
