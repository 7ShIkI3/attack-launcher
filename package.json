{
  "name": "attack-launcher",
  "productName": "ATTACK Launcher",
  "version": "0.2.0",
  "description": "Launcher d'ATTACK Client (Minecraft 1.8.9 PvP) : installe Forge et le mod, connexion Microsoft et lancement direct du jeu.",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "7ShIkI3",
  "homepage": "https://github.com/7ShIkI3/attack-launcher",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/make-icons.js",
    "install-test": "node scripts/install-test.js",
    "launch-test": "node scripts/launch-test.js",
    "screenshot": "node scripts/screenshot.js",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --win --dir"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "io.github.7shiki3.attacklauncher",
    "productName": "ATTACK Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ATTACK Launcher",
      "artifactName": "ATTACK-Launcher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ATTACK-Launcher-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
