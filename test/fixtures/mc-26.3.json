{
  "arguments": {
    "default-user-jvm": [
      {
        "value": [
          "-Xms2G",
          "-Xmx4G",
          "-XX:+UseCompactObjectHeaders",
          "-XX:+AlwaysPreTouch",
          "-XX:+UseStringDeduplication"
        ]
      },
      {
        "rules": [
          {
            "action": "allow",
